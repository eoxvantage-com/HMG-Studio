  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs",
    "start": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
