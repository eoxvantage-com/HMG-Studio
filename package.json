  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "refine": {
    "projectId": "obEpHJ-M7JimA-31GF1J"
  },
  "overrides": {
    "@mui/base": {
      "react": "$react",
      "react-dom": "$react-dom",
