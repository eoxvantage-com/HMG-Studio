      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-virtual": {
      "react": "$react"
    },
    "notistack": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@mui/material": "$@mui/material"
    },
    "react-reconciler": {
      "react": "$react"
    },
    "@mui/lab": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
